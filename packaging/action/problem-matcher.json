{
  "problemMatcher": [
    {
      "owner": "shellcheck-rust-gcc",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|note|info|style): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ],
      "severity": "warning"
    }
  ]
}
