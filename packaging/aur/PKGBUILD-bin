# Maintainer: devansh choubey <devanshc13 at gmail dot com>
# Binary package: installs the static musl release tarball (no Rust needed).
pkgname=shellcheck-rust-bin
pkgver=0.0.1
pkgrel=1
pkgdesc="A Rust port of ShellCheck: finds bugs in shell scripts (prebuilt static binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/DevanshChoubey/shellcheck-rust"
license=('GPL-3.0-or-later')
provides=('shellcheck-rust')
conflicts=('shellcheck-rust')
options=('!strip')
source_x86_64=("$url/releases/download/v$pkgver/shellcheck-rust-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/shellcheck-rust-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64_LINUX@')
sha256sums_aarch64=('@SHA256_AARCH64_LINUX@')

package() {
  install -Dm755 shellcheck-rust "$pkgdir/usr/bin/shellcheck-rust"
}
